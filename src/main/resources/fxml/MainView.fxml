<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.twinsubs.ui.controller.MainController"
            fitToWidth="true"
            styleClass="main-scroll-pane"
      stylesheets="@/css/style.css">

    <VBox spacing="15" minWidth="880">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header -->
    <VBox spacing="2">
        <Label text="%app.title" styleClass="title-label"/>
        <Label text="%app.subtitle" styleClass="subtitle-label"/>
    </VBox>

        <!-- Initial Drag & Drop Zone Container (Centered Vertically) -->
        <VBox fx:id="vboxInitialDrop" spacing="5" alignment="CENTER" minHeight="420">
    <StackPane fx:id="dropZone" styleClass="drop-zone"
               onDragOver="#handleDragOver" onDragDropped="#handleDragDropped"
               onMouseClicked="#handleZoneClick"
                   prefHeight="180" maxWidth="680">
            <VBox alignment="CENTER" spacing="8">
                <Label text="%dropzone.prompt" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4b5563;"/>
            <Label fx:id="lblFileSummary" text="%dropzone.summary.none" styleClass="subtitle-label"/>
        </VBox>
    </StackPane>
    </VBox>

    <!-- Compact File Summary Bar (Visible when files loaded) -->
    <HBox fx:id="hboxCompactSummary" styleClass="section-box" alignment="CENTER_LEFT" spacing="15" visible="false" managed="false">
        <Label fx:id="lblCompactFileSummary" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" HBox.hgrow="ALWAYS"/>
        <Button text="%btn.change_files" onAction="#handleChangeFiles" style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-cursor: hand;"/>
    </HBox>

    <!-- Configuration & Live Preview Area (Hidden by default) -->
    <VBox fx:id="vboxConfiguration" spacing="15" visible="false" managed="false">
            <HBox spacing="15">

            <!-- Left Column: Controls & Configuration -->
            <VBox spacing="15" HBox.hgrow="ALWAYS" prefWidth="480" minWidth="420">

        <!-- Subtitle Track Selection Section -->
    <VBox styleClass="section-box" spacing="10">
            <Label text="%section.tracks.title" styleClass="section-title"/>
            <GridPane hgap="15" vgap="10">
                <Label text="%label.primary_track" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="comboPrimaryTrack" prefWidth="250" minWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="%label.secondary_track" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="comboSecondaryTrack" prefWidth="250" minWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>
        </VBox>

        <!-- Styles & Positioning Section -->
        <VBox styleClass="section-box" spacing="12">
            <Label text="%section.styles.title" styleClass="section-title"/>

            <HBox spacing="15">
                <!-- Primary Style -->
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="%section.style.primary_title" styleClass="section-subtitle-sm"/>
                <GridPane hgap="8" vgap="6">
                    <Label text="%label.font" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtPrimaryFont" text="Arial" prefWidth="110" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="%label.size" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Spinner fx:id="spnPrimarySize" initialValue="50" min="10" max="100" prefWidth="80" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="%label.color" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <ColorPicker fx:id="cpPrimaryColor" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <CheckBox fx:id="chkPrimaryBold" text="%checkbox.bold" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <CheckBox fx:id="chkPrimaryItalic" text="%checkbox.italic" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>
            </VBox>

            <!-- Secondary Style -->
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="%section.style.secondary_title" styleClass="section-subtitle-sm"/>
                <GridPane hgap="8" vgap="6">
                    <Label text="%label.font" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtSecondaryFont" text="Arial" prefWidth="110" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="%label.size" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Spinner fx:id="spnSecondarySize" initialValue="38" min="10" max="100" prefWidth="80" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="%label.color" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <ColorPicker fx:id="cpSecondaryColor" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <CheckBox fx:id="chkSecondaryBold" text="%checkbox.bold" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <CheckBox fx:id="chkSecondaryItalic" text="%checkbox.italic" selected="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>
            </VBox>
        </HBox>

            <Separator/>
            <!-- Positioning Layout Option -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="%label.position_mode" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <ComboBox fx:id="comboPositionMode" prefWidth="220" minWidth="180"/>
            </HBox>
</VBox>

        <!-- Settings & Output Section -->
        <VBox styleClass="section-box" spacing="10">
            <Label text="%section.settings.title" styleClass="section-title"/>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="%label.output_option" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <ComboBox fx:id="comboOutputOption" prefWidth="240" minWidth="180"/>
            </HBox>
        </VBox>
        </VBox>

        <!-- Right Column: Live Subtitle Preview Pane -->
        <VBox styleClass="section-box" spacing="10" prefWidth="420" minWidth="380" HBox.hgrow="NEVER">
            <Label text="%section.preview.title" styleClass="section-title"/>

            <StackPane fx:id="previewCanvas" styleClass="preview-container" prefWidth="390" prefHeight="260" minHeight="260">
                <!-- Video Background Image -->
                <ImageView fx:id="imgPreviewBackground" fitWidth="390" fitHeight="260" preserveRatio="false"/>

                <!-- Top Subtitles Container -->
                <VBox fx:id="vboxPreviewTop" alignment="TOP_CENTER" spacing="4" StackPane.alignment="TOP_CENTER">
                    <padding>
                        <Insets top="15" right="10" bottom="10" left="10"/>
                    </padding>
                </VBox>

                <!-- Bottom Subtitles Container -->
                <VBox fx:id="vboxPreviewBottom" alignment="BOTTOM_CENTER" spacing="4" StackPane.alignment="BOTTOM_CENTER">
                    <padding>
                        <Insets top="10" right="10" bottom="15" left="10"/>
                    </padding>
                </VBox>
            </StackPane>
        </VBox>
    </HBox>

        <!-- Progress & Action -->
        <VBox spacing="8" alignment="CENTER">
            <ProgressBar fx:id="progressBar" progress="0.0" prefWidth="760"/>
            <Label fx:id="lblStatus" text="%status.ready" styleClass="subtitle-label"/>
            <Button fx:id="btnStart" text="%btn.start" styleClass="action-button" onAction="#handleStartProcessing" disable="true"/>
        </VBox>

    </VBox>
</VBox>
</ScrollPane>

